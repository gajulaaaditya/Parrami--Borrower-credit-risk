proc sql noremerge;
/* Every row of qa_failures must have failure_count = 0. */
create table qa_failures as
select cast('duplicate_borrower_key' as char(32)) as check_name, count(*) as failure_count from
 (select borrower_id from borrowers group by borrower_id having count(*)>1) x
union all select 'duplicate_loan_key', count(*) from
 (select loan_id from loans group by loan_id having count(*)>1) x
union all select 'duplicate_snapshot_key', count(*) from
 (select loan_id,snapshot_date from performance group by loan_id,snapshot_date having count(*)>1) x
union all select 'orphan_loans',count(*) from loans l left join borrowers b
 on l.borrower_id=b.borrower_id where b.borrower_id is null
union all select 'orphan_snapshots',count(*) from performance p left join loans l
 on p.loan_id=l.loan_id where l.loan_id is null
union all select 'invalid_loan_values',count(*) from loans where
 original_principal is null or original_principal<=0 or annual_rate is null or annual_rate<0
 or scheduled_installment is null or scheduled_installment<=0 or term_months is null or term_months<=0
 or collateral_value is null or collateral_value<0
union all select 'invalid_snapshot_values',count(*) from performance where
 outstanding_balance is null or outstanding_balance<0 or days_past_due is null or days_past_due<0
union all select 'missing_asof_snapshot',count(*) from loans l left join performance p
 on l.loan_id=p.loan_id and p.snapshot_date='2025-09-30'
 where l.origination_date<='2025-09-30' and p.loan_id is null
union all select 'invalid_borrower_values',count(*) from borrowers where
 (annual_income is not null and annual_income<=0) or
 (credit_score is not null and (credit_score<300 or credit_score>850)) or
 existing_monthly_debt is null or existing_monthly_debt<0;
/* Expected missingness is reported separately; never replace income with zero. */
create table data_quality_profile as
select count(*) as borrowers, sum(case when annual_income is null then 1 else 0 end) as missing_income,
 sum(case when credit_score is null then 1 else 0 end) as missing_credit_score from borrowers;

quit;
proc sql noprint;
 select sum(failure_count) into :qa_total trimmed from qa_failures;
quit;
%macro analyze;
 %if &qa_total ne 0 %then %do;
  %put ERROR: Mandatory data quality checks failed. Inspect WORK.QA_FAILURES.;
  %return;
 %end;
 proc sql noremerge;
/* Fixed reporting date; future performance is deliberately excluded. */
create table active_loans as
select l.*,p.snapshot_date,p.outstanding_balance,p.days_past_due
from loans l inner join performance p on l.loan_id=p.loan_id
where p.snapshot_date='2025-09-30' and l.origination_date<=p.snapshot_date
 and p.outstanding_balance>0;
/* Aggregate loan obligations BEFORE joining borrower features. */
create table borrower_obligations as
select borrower_id,count(*) as active_loan_count,
 sum(scheduled_installment) as project_monthly_installments,
 sum(outstanding_balance) as borrower_exposure
from active_loans group by borrower_id;
create table borrower_features as
select b.*,o.active_loan_count,o.project_monthly_installments,o.borrower_exposure,
 case when b.annual_income is not null and b.annual_income>0
 then (b.existing_monthly_debt+o.project_monthly_installments)/(b.annual_income/12.0)
 end as dti
from borrowers b inner join borrower_obligations o on b.borrower_id=o.borrower_id;
create table loan_features as
select a.*, b.region,b.employment_type,b.annual_income,b.credit_score,b.dti,
 case when a.days_past_due>=90 then '90+ DPD'
      when a.days_past_due>=60 then '60-89 DPD'
      when a.days_past_due>=30 then '30-59 DPD'
      when a.days_past_due>0 then '1-29 DPD' else 'Current' end as delinquency_bucket,
 case when a.days_past_due>=30 then 1 else 0 end as dpd30_flag,
 case when a.days_past_due>=90 then 1 else 0 end as dpd90_flag,
 case when b.credit_score is null or b.dti is null then 'Unclassified'
      when a.days_past_due>=30 or b.credit_score<600 or b.dti>0.50 then 'High'
      when a.days_past_due>0 or b.credit_score<700 or b.dti>0.35 then 'Medium'
      else 'Low' end as risk_segment,
 /* Teaching assumptions, NOT fitted or validated probabilities. */
 case when a.days_past_due>=90 then 1.00
      when b.credit_score is null or b.dti is null then 0.08
      when a.days_past_due>=30 or b.credit_score<600 or b.dti>0.50 then 0.12
      when a.days_past_due>0 or b.credit_score<700 or b.dti>0.35 then 0.04
      else 0.01 end as assumed_pd,
 case when 0.70*a.collateral_value>=a.outstanding_balance then 0
      else 1.0-0.70*a.collateral_value/a.outstanding_balance end as assumed_lgd
from active_loans a inner join borrower_features b on a.borrower_id=b.borrower_id;
create table loan_risk as
select f.*, outstanding_balance*assumed_pd*assumed_lgd as illustrative_expected_loss,
 outstanding_balance*annual_rate as annual_interest_run_rate
from loan_features f;
create table portfolio_summary as
select count(*) as active_loans,count(distinct borrower_id) as active_borrowers,
 sum(outstanding_balance) as total_exposure,
 avg(dpd30_flag*1.0) as dpd30_loan_rate,avg(dpd90_flag*1.0) as dpd90_loan_rate,
 sum(case when dpd30_flag=1 then outstanding_balance else 0 end)/sum(outstanding_balance) as par30,
 sum(case when dpd90_flag=1 then outstanding_balance else 0 end)/sum(outstanding_balance) as par90,
 sum(outstanding_balance*annual_rate)/sum(outstanding_balance) as weighted_annual_rate,
 sum(annual_interest_run_rate) as annual_interest_run_rate,
 sum(illustrative_expected_loss) as illustrative_expected_loss,
 sum(illustrative_expected_loss)/sum(outstanding_balance) as expected_loss_ratio
from loan_risk;
create table risk_summary as
select risk_segment,count(*) as loans,sum(outstanding_balance) as exposure,
 avg(dpd30_flag*1.0) as dpd30_loan_rate,
 sum(illustrative_expected_loss) as illustrative_expected_loss
from loan_risk group by risk_segment;
create table product_summary as
select product,count(*) as loans,sum(outstanding_balance) as exposure,
 sum(case when dpd30_flag=1 then outstanding_balance else 0 end)/sum(outstanding_balance) as par30,
 sum(illustrative_expected_loss) as illustrative_expected_loss
from loan_risk group by product;
create table region_summary as
select region,count(*) as loans,count(distinct borrower_id) as borrowers,
 sum(outstanding_balance) as exposure,
 sum(case when dpd90_flag=1 then outstanding_balance else 0 end)/sum(outstanding_balance) as par90
from loan_risk group by region;
/* Ratios at borrower grain: do not average repeated borrower DTIs from loan_risk. */
create table affordability_summary as
select count(*) as active_borrowers,count(dti) as known_dti_borrowers,
 avg(dti) as mean_known_dti,
 sum(case when dti>0.50 then 1 else 0 end)*1.0/count(dti) as over50_share_of_known
from borrower_features;
create table monthly_trend as
select p.snapshot_date,count(*) as active_loans,sum(p.outstanding_balance) as exposure,
 sum(case when p.days_past_due>=30 then p.outstanding_balance else 0 end)/sum(p.outstanding_balance) as par30,
 sum(case when p.days_past_due>=90 then p.outstanding_balance else 0 end)/sum(p.outstanding_balance) as par90
from performance p inner join loans l on p.loan_id=l.loan_id
where p.snapshot_date<='2025-09-30' and l.origination_date<=p.snapshot_date
 and p.outstanding_balance>0 group by p.snapshot_date;
create table collections_queue as
select loan_id,borrower_id,product,days_past_due,outstanding_balance,risk_segment,
 illustrative_expected_loss from loan_risk where days_past_due>=30
order by days_past_due desc,outstanding_balance desc,loan_id;

 quit;
 title 'Synthetic borrower credit risk: 30 September 2025';
 proc print data=qa_failures noobs; run;
 proc print data=portfolio_summary noobs; run;
 proc print data=risk_summary noobs; run;
 proc print data=collections_queue(obs=20) noobs; run;
 title;
%mend;
%analyze;
